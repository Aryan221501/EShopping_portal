# Environment variables for AI E-Shop

# Django settings
DEBUG=True
DJANGO_SECRET_KEY=django-insecure-your-secret-key-here-for-development-only

# Database (only used if not defaulting to local db)
# DATABASE_URL=postgresql://user:password@localhost/db_name

# Email settings (optional)
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=your-email@gmail.com
# EMAIL_HOST_PASSWORD=your-app-password
# EMAIL_USE_TLS=True

# AI Settings
# GEMINI_API_KEY=your-gemini-api-key-here  # Uncomment this line when you use it (never commit this with real keys!)

# Server settings
ALLOWED_HOSTS=localhost,127.0.0.1